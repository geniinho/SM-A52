# Config extra para Docker nativo (kernel 4.14.190 / a52q)
# Usado via scripts/kconfig/merge_config.sh em cima do defconfig Samsung.

# --- namespaces (o que falta hoje) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- cgroups ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y

# --- filesystem / binários ---
CONFIG_OVERLAY_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_FUSE_FS=y
CONFIG_POSIX_MQUEUE=y

# --- rede para containers ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP_VS=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y

# --- extras úteis ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_CHECKPOINT_RESTORE=y

# --- desliga guardas de integridade da Samsung ---
# Com o bootloader destravado (Knox 0x1) esses guardas nao protegem nada,
# mas o hypervisor/TZ da Samsung MATA o kernel na inicializacao quando o
# texto do kernel nao bate com o assinado -> bootloop sem USB (tela preta).
# Kernels customizados para Samsung sempre desligam esses itens.
# CONFIG_RKP_NS_PROT is not set
# CONFIG_RKP_KDP is not set
# CONFIG_RKP_DMAP_PROT is not set
# CONFIG_UH_RKP is not set
# CONFIG_RKP_MODULE_SUPPORT is not set
# ATENCAO: KNOX_NCM NAO pode sair — net/core/sock.c e net/ipv4/udp.c
# chamam check_ncm_flag()/knox_collect_conntrack_data() sem #ifdef
# (undefined symbol no link). E so monitoramento de conexoes.
CONFIG_KNOX_NCM=y
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_PROCA is not set
# CONFIG_FIVE is not set
# CONFIG_SECURITY_DSMS is not set
# ATENCAO: SEC_DEBUG NAO pode ser desligado — arch/arm64/kernel/traps.c
# chama sec_debug_sched_msg()/sec_debug_summary_save_die_info() sem #ifdef.
CONFIG_SEC_DEBUG=y

# O aparelho nao usa modulos .ko: dispensa CRC/versao de simbolos
# (evita falha de genksyms no modpost neste kernel Samsung)
# CONFIG_MODVERSIONS is not set
